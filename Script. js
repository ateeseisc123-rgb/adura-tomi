// 1. TIME-BASED GREETING (Switches to Good evening at 5:00 PM)
function updateGreeting() {
  const hour = new Date().getHours();
  const greetingElement = document.getElementById("greeting");
  if (!greetingElement) return;

  if (hour >= 5 && hour < 12) {
    greetingElement.textContent = "Good morning";
  } else if (hour >= 12 && hour < 17) {
    greetingElement.textContent = "Good afternoon";
  } else {
    greetingElement.textContent = "Good evening";
  }
}

// 2. OUTFIT CATEGORY FILTER
function filterOutfits(category) {
  const cards = document.querySelectorAll(".product-card");
  const buttons = document.querySelectorAll(".filter-btn");

  buttons.forEach((btn) => {
    btn.classList.toggle("active", btn.dataset.category === category);
  });

  cards.forEach((card) => {
    if (category === "all" || card.dataset.category === category) {
      card.style.display = "block";
    } else {
      card.style.display = "none";
    }
  });
}

// 3. SHOPPING CART LOGIC (Saved in localStorage)
let cart = JSON.parse(localStorage.getItem("shopCart")) || [];

function saveCart() {
  localStorage.setItem("shopCart", JSON.stringify(cart));
  renderCart();
}

function addToCart(name, price, size = "M") {
  const existingItem = cart.find(
    (item) => item.name === name && item.size === size
  );

  if (existingItem) {
    existingItem.quantity += 1;
  } else {
    cart.push({ name, price: Number(price), size, quantity: 1 });
  }

  saveCart();
}

function removeFromCart(index) {
  cart.splice(index, 1);
  saveCart();
}

function clearCart() {
  cart = [];
  saveCart();
}

function renderCart() {
  const cartContainer = document.getElementById("cart-items");
  const cartTotalEl = document.getElementById("cart-total");
  const cartCountEl = document.getElementById("cart-count");

  let total = 0;
  let totalItems = 0;

  cart.forEach((item) => {
    total += item.price * item.quantity;
    totalItems += item.quantity;
  });

  if (cartCountEl) {
    cartCountEl.textContent = totalItems;
  }

  if (cartTotalEl) {
    cartTotalEl.textContent = `GHS ${total.toFixed(2)}`;
  }

  if (!cartContainer) return;

  if (cart.length === 0) {
    cartContainer.innerHTML = "<p>Your cart is currently empty.</p>";
    return;
  }

  cartContainer.innerHTML = cart
    .map(
      (item, index) => `
      <div class="cart-item">
        <div>
          <strong>${item.name}</strong> (Size: ${item.size})<br>
          <span>GHS ${item.price.toFixed(2)} x ${item.quantity}</span>
        </div>
        <button type="button" onclick="removeFromCart(${index})">Remove</button>
      </div>
    `
    )
    .join("");
}

// 4. WHATSAPP ORDER CHECKOUT
function checkoutWhatsApp() {
  if (cart.length === 0) {
    alert("Please add an outfit to your cart before ordering.");
    return;
  }

  const phoneNumber = "233000000000"; // Replace with your WhatsApp number
  let message = "Hello, I would like to place an order:\n\n";
  let total = 0;

  cart.forEach((item, i) => {
    const subtotal = item.price * item.quantity;
    total += subtotal;
    message += `${i + 1}. ${item.name} (Size: ${item.size}) - Qty: ${item.quantity} - GHS ${subtotal.toFixed(2)}\n`;
  });

  message += `\nTotal: GHS ${total.toFixed(2)}`;

  const url = `https://wa.me{phoneNumber}?text=${encodeURIComponent(message)}`;
  window.open(url, "_blank");
}

// 5. INITIALIZE ON PAGE LOAD
document.addEventListener("DOMContentLoaded", () => {
  updateGreeting();
  setInterval(updateGreeting, 60000);
  renderCart();
});
