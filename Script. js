function getGhanaHour() {
  const ghanaTime = new Date().toLocaleString("en-US", {
    timeZone: "Africa/Accra",
    hour: "numeric",
    hour12: false
  });
  return parseInt(ghanaTime, 10);
}

function updateGreeting() {
  const hour = getGhanaHour();
  const heading = document.getElementById("welcomeHeading");
  const subtitle = document.getElementById("welcomeSubtitle");
  const displayName = currentUser?.displayName || currentUser?.email?.split("@")[0] || "Welcome";
  const firstName = displayName.split(" ")[0];

  if (hour >= 5 && hour < 12) {
    heading.textContent = `Mema wo akyire, ${firstName}!`;
    subtitle.textContent = "Good Morning! Welcome to ISC ENTERPRISE";
  } else if (hour >= 12 && hour < 17) {
    heading.textContent = `Mema wo aha, ${firstName}!`;
    subtitle.textContent = "Good Afternoon! Welcome to ISC ENTERPRISE";
  } else {
    heading.textContent = `Mema wo adwo, ${firstName}!`;
    subtitle.textContent = "Good Evening! Welcome to ISC ENTERPRISE";
  }
}

updateGreeting();
setInterval(updateGreeting, 30000);

