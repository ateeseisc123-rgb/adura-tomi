document.getElementById("authForm").addEventListener("submit", async (e) => {
  e.preventDefault();
  const authSubmitBtn = document.getElementById("authSubmitBtn");
  const email = document.getElementById("authEmail").value.trim();
  const password = document.getElementById("authPassword").value;
  const fullName = document.getElementById("authName").value.trim();
  const phone = document.getElementById("authPhone").value.trim();

  authSubmitBtn.disabled = true;
  authSubmitBtn.textContent = isSignupMode ? "Creating Account..." : "Logging in...";

  try {
    if (isSignupMode) {
      const cred = await createUserWithEmailAndPassword(auth, email, password);
      const nameToSave = fullName || email.split("@")[0];
      await updateProfile(cred.user, { displayName: nameToSave });

      await setDoc(doc(db, "users", cred.user.uid), {
        name: nameToSave,
        email,
        phone,
        points: 0,
        createdAt: serverTimestamp()
      });
    } else {
      await signInWithEmailAndPassword(auth, email, password);
    }

    authModal.style.display = "none";
    document.getElementById("authForm").reset();
  } catch (error) {
    alert(error.message);
  } finally {
    authSubmitBtn.disabled = false;
    authSubmitBtn.textContent = isSignupMode ? "Create Account" : "Login";
  }
});

