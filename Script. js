// ==========================================
// 5. DASHBOARD <-> NETWORK STORE SWITCHER
// ==========================================
const homeDashboardView = document.getElementById("homeDashboardView");
const networkStoreView = document.getElementById("networkStoreView");
const storeNetworkTitle = document.getElementById("storeNetworkTitle");
const bundleGrid = document.getElementById("datamartBundleGrid");

function openNetworkStore(network) {
  currentNetwork = network;
  currentTab = "standard";
  document.getElementById("tabStandardBundles").classList.add("active");
  document.getElementById("tabPromoBundles").classList.remove("active");

  storeNetworkTitle.textContent = `${network} Data Bundles`;
  homeDashboardView.style.display = "none";
  networkStoreView.style.display = "block";
  renderBundles();
  closeDrawer();
  window.scrollTo({ top: 0, behavior: "smooth" });
}

function showDashboard() {
  networkStoreView.style.display = "none";
  homeDashboardView.style.display = "block";
  closeDrawer();
}

function renderBundles() {
  const list = BUNDLES[currentNetwork][currentTab];
  bundleGrid.innerHTML = "";

  const cardClass =
    currentNetwork === "Telecel"
      ? "telecel-card"
      : currentNetwork === "AirtelTigo"
      ? "at-card"
      : "";

  list.forEach((item) => {
    const card = document.createElement("div");
    card.className = `dm-bundle-card ${cardClass}`;
    card.innerHTML = `
      <div>
        <span class="dm-mini-badge">${currentNetwork}</span>
        <div class="dm-size">${item.size}</div>
        <div class="dm-sub">Instant Delivery</div>
      </div>
      <div class="dm-card-bottom">
        <span class="dm-price">GHS ${item.price.toFixed(2)}</span>
        <span class="dm-expiry">${item.validity}</span>
      </div>
    `;
    card.addEventListener("click", () => openOrderModal(currentNetwork, item.id));
    bundleGrid.appendChild(card);
  });
}
document.getElementById("selectMtn").addEventListener("click", () => openNetworkStore("MTN"));
document.getElementById("selectAirtelTigo").addEventListener("click", () => openNetworkStore("AirtelTigo"));
document.getElementById("selectTelecel").addEventListener("click", () => openNetworkStore("Telecel"));

