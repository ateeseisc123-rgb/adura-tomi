// 7. AUTH MODAL & LEADERBOARD
// ==========================================
const authModal = document.getElementById("authModal");
const openAuthBtn = document.getElementById("openAuthBtn");

function updateAuthUI() {
  const drawerUserName = document.getElementById("drawerUserName");
  const drawerProfileSub = document.getElementById("drawerProfileSub");
  const userPointsBadge = document.getElementById("userPointsBadge");
  const menuLogout = document.getElementById("menuLogout");

  if (currentUser) {
    openAuthBtn.textContent = currentUser.name.split(" ");
    drawerUserName.textContent = currentUser.name.toUpperCase();
    drawerProfileSub.textContent = currentUser.email;
    userPointsBadge.textContent = `Loyalty Points: ${orders.length * 10} pts`;
    menuLogout.style.display = "block";
  } else {
    openAuthBtn.textContent = "Login";
    drawerUserName.textContent = "ISC GUEST";
    drawerProfileSub.textContent = "Tap to Login / Sign Up";
    userPointsBadge.textContent = "Sign in to earn loyalty points";
    menuLogout.style.display = "none";
  }
  updateGreeting();
}

openAuthBtn.addEventListener("click", () => { authModal.style.display = "flex"; });
document.getElementById("profileIconBtn").addEventListener("click", () => { authModal.style.display = "flex"; });
document.getElementById("drawerProfileCard").addEventListener("click", () => { closeDrawer(); authModal.style.display = "flex"; });
document.getElementById("closeAuthBtn").addEventListener("click", () => { authModal.style.display = "none"; });

document.getElementById("toggleAuthModeBtn").addEventListener("click", () => {
  isSignupMode = !isSignupMode;
  document.getElementById("nameGroup").style.display = isSignupMode ? "block" : "none";
  document.getElementById("phoneGroup").style.display = isSignupMode ? "block" : "none";
  document.getElementById("authModalTitle").textContent = isSignupMode ? "Create ISC Account" : "Login to ISC ENTERPRISE";
  document.getElementById("authSubmitBtn").textContent = isSignupMode ? "Create Account" : "Login";
  document.getElementById("authSwitchPrompt").textContent = isSignupMode ? "Already have an account?" : "Don't have an account?";
  document.getElementById("toggleAuthModeBtn").textContent = isSignupMode ? "Login" : "Create Account";
});

document.getElementById("authForm").addEventListener("submit", (e) => {
  e.preventDefault();
  const email = document.getElementById("authEmail").value.trim();
  const nameInput = document.getElementById("authName").value.trim();
  const displayName = isSignupMode && nameInput ? nameInput : email.split("@");

  currentUser = { name: displayName, email };
  localStorage.setItem("isc_user", JSON.stringify(currentUser));
  authModal.style.display = "none";
  updateAuthUI();
});

document.getElementById("menuLogout").addEventListener("click", () => {
  currentUser = null;
  localStorage.removeItem("isc_user");
  closeDrawer();
  updateAuthUI();
});

