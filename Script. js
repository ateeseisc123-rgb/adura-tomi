document.addEventListener("DOMContentLoaded", () => {
  // 1. Packages Data
  const packages = {
    MTN: [
      { size: "1GB", label: "1 GB — GHS 5.00", price: "₵5.00" },
      { size: "2GB", label: "2 GB — GHS 9.50", price: "₵9.50" },
      { size: "3GB", label: "3 GB — GHS 13.50", price: "₵13.50" },
      { size: "5GB", label: "5 GB — GHS 22.00", price: "₵22.00" },
      { size: "10GB", label: "10 GB — GHS 42.00", price: "₵42.00" }
    ],
    AirtelTigo: [
      { size: "1GB", label: "1 GB — GHS 4.50", price: "₵4.50" },
      { size: "2GB", label: "2 GB — GHS 8.50", price: "₵8.50" },
      { size: "5GB", label: "5 GB — GHS 19.50", price: "₵19.50" },
      { size: "10GB", label: "10 GB — GHS 36.00", price: "₵36.00" }
    ],
    Telecel: [
      { size: "2GB", label: "2 GB — GHS 9.00", price: "₵9.00" },
      { size: "5GB", label: "5 GB — GHS 20.00", price: "₵20.00" },
      { size: "10GB", label: "10 GB — GHS 38.00", price: "₵38.00" },
      { size: "15GB", label: "15 GB — GHS 55.00", price: "₵55.00" }
    ]
  };

  let selectedNetwork = "MTN";
  const orders = [];

  // 2. Automatic Time-Based Greeting (Morning / Afternoon / Evening)
  function updateGreeting(userName = "Welcome") {
    const hour = new Date().getHours();
    let twiGreeting = "Mema wo akye";
    let engGreeting = "Good Morning";

    if (hour >= 12 && hour < 17) {
      twiGreeting = "Mema wo aha";
      engGreeting = "Good Afternoon";
    } else if (hour >= 17 || hour < 5) {
      twiGreeting = "Mema wo adwo";
      engGreeting = "Good Evening";
    }

    const headingEl = document.getElementById("welcomeHeading");
    const subEl = document.getElementById("welcomeSubtitle");
    if (headingEl) headingEl.textContent = `${twiGreeting}, ${userName}!`;
    if (subEl) subEl.textContent = `${engGreeting}! Welcome to ISC ENTERPRISE`;
  }

  updateGreeting();
  setInterval(() => updateGreeting(), 60000);

  // 3. Slide-Out Drawer Menu Logic
  const menuBtn = document.getElementById("menuBtn");
  const closeDrawerBtn = document.getElementById("closeDrawerBtn");
  const sideDrawer = document.getElementById("sideDrawer");
  const drawerOverlay = document.getElementById("drawerOverlay");

  function openDrawer() {
    sideDrawer.classList.add("active");
    drawerOverlay.classList.add("active");
  }

  function closeDrawer() {
    sideDrawer.classList.remove("active");
    drawerOverlay.classList.remove("active");
  }

  menuBtn.addEventListener("click", openDrawer);
  closeDrawerBtn.addEventListener("click", closeDrawer);
  drawerOverlay.addEventListener("click", closeDrawer);

  // Dark Mode Switch inside Drawer
  const darkModeToggle = document.getElementById("darkModeToggle");
  if (darkModeToggle) {
    darkModeToggle.addEventListener("change", (e) => {
      document.body.classList.toggle("dark-theme", e.target.checked);
    });
  }

  // 4. DataMart Network Bundle View Switcher
  const homeDashboardView = document.getElementById("homeDashboardView");
  const networkStoreView = document.getElementById("networkStoreView");
  const storeNetworkTitle = document.getElementById("storeNetworkTitle");
  const datamartBundleGrid = document.getElementById("datamartBundleGrid");

  function showNetworkBundles(network) {
    selectedNetwork = network;
    homeDashboardView.style.display = "none";
    networkStoreView.style.display = "block";
    storeNetworkTitle.textContent = `${network} Data Bundles`;

    const cardColorClass =
      network === "Telecel" ? "telecel-card" : network === "AirtelTigo" ? "at-card" : "";

    datamartBundleGrid.innerHTML = packages[network]
      .map(
        (pkg) => `
        <div class="dm-bundle-card ${cardColorClass}" data-pkg="${pkg.label}">
          <div>
            <div class="dm-card-top">
              <span class="dm-mini-badge">${network}</span>
            </div>
            <div class="dm-size">${pkg.size}</div>
            <div class="dm-sub">${network} Bundle</div>
          </div>
          <div class="dm-card-bottom">
            <span class="dm-price">${pkg.price}</span>
            <span class="dm-expiry">No Expiry</span>
          </div>
        </div>
      `
      )
      .join("");

    datamartBundleGrid.querySelectorAll(".dm-bundle-card").forEach((card) => {
      card.addEventListener("click", () => {
        openOrderModal(network, card.getAttribute("data-pkg"));
      });
    });

    window.scrollTo({ top: 0, behavior: "smooth" });
  }

  function showHomeDashboard() {
    networkStoreView.style.display = "none";
    homeDashboardView.style.display = "block";
  }

  document.getElementById("selectMtn").addEventListener("click", () => showNetworkBundles("MTN"));
  document.getElementById("selectAirtelTigo").addEventListener("click", () => showNetworkBundles("AirtelTigo"));
  document.getElementById("selectTelecel").addEventListener("click", () => showNetworkBundles("Telecel"));
  document.getElementById("backToDashboardBtn").addEventListener("click", showHomeDashboard);
  document.getElementById("brandHomeBtn").addEventListener("click", showHomeDashboard);

  // Drawer Menu Navigation Links
  document.getElementById("menuDashboard").addEventListener("click", (e) => {
    e.preventDefault();
    showHomeDashboard();
    closeDrawer();
  });

  document.getElementById("menuMtn").addEventListener("click", (e) => {
    e.preventDefault();
    showNetworkBundles("MTN");
    closeDrawer();
  });

  document.getElementById("menuAirtelTigo").addEventListener("click", (e) => {
    e.preventDefault();
    showNetworkBundles("AirtelTigo");
    closeDrawer();
  });

  document.getElementById("menuTelecel").addEventListener("click", (e) => {
    e.preventDefault();
    showNetworkBundles("Telecel");
    closeDrawer();
  });

  document.getElementById("menuOrders").addEventListener("click", () => closeDrawer());
  document.getElementById("menuLeaderboard").addEventListener("click", () => closeDrawer());
  document.getElementById("menuContact").addEventListener("click", () => closeDrawer());

  // 5. Order Modal & Recent Orders
  const modal = document.getElementById("orderModal");
  const modalTitle = document.getElementById("modalTitle");
  const bundleSelect = document.getElementById("bundleSelect");
  const bundleForm = document.getElementById("bundleForm");
  const ordersList = document.getElementById("ordersList");
  const orderCountBadge = document.getElementById("orderCountBadge");

  function openOrderModal(network, preselectedLabel = null) {
    selectedNetwork = network;
    modalTitle.textContent = `Buy ${network} Data`;

    bundleSelect.innerHTML = "";
    packages[network].forEach((pkg) => {
      const option = document.createElement("option");
      option.value = pkg.label;
      option.textContent = pkg.label;
      if (preselectedLabel && pkg.label === preselectedLabel) {
        option.selected = true;
      }
      bundleSelect.appendChild(option);
    });

    modal.style.display = "flex";
  }

  function closeOrderModal() {
    modal.style.display = "none";
    bundleForm.reset();
  }

  document.getElementById("closeModalBtn").addEventListener("click", closeOrderModal);
  modal.addEventListener("click", (e) => {
    if (e.target === modal) closeOrderModal();
  });

  bundleForm.addEventListener("submit", (event) => {
    event.preventDefault();

    const chosenBundle = bundleSelect.value;
    const phone = document.getElementById("recipientPhone").value.trim();

    if (phone.length < 10) {
      alert("Please enter a valid 10-digit Ghana phone number.");
      return;
    }

    orders.unshift({
      network: selectedNetwork,
      bundle: chosenBundle,
      phone: phone,
      time: new Date().toLocaleTimeString([], { hour: "2-digit", minute: "2-digit" })
    });

    renderOrders();
    closeOrderModal();
    document.getElementById("orders-section").scrollIntoView({ behavior: "smooth" });
  });

  function renderOrders() {
    if (orderCountBadge) {
      orderCountBadge.textContent = `${orders.length} Order${orders.length === 1 ? "" : "s"}`;
    }

    if (orders.length === 0) {
      ordersList.innerHTML = `<p class="empty-text">No recent orders yet. Select a network above to buy data.</p>`;
      return;
    }

    ordersList.innerHTML = orders
      .map(
        (order) => `
      <div class="order-item">
        <div class="order-info">
          <strong>${order.network} • ${order.bundle}</strong>
          <span>To: ${order.phone} • ${order.time}</span>
        </div>
        <span class="status-badge">Pending</span>
      </div>
    `
      )
      .join("");
  }

  const clearBtn = document.getElementById("clearOrdersBtn");
  if (clearBtn) {
    clearBtn.addEventListener("click", () => {
      orders.length = 0;
      renderOrders();
    });
  }

  // 6. Auth Modal Open/Close Handlers
  const authModal = document.getElementById("authModal");
  const openAuthBtn = document.getElementById("openAuthBtn");
  const closeAuthBtn = document.getElementById("closeAuthBtn");
  const drawerProfileCard = document.getElementById("drawerProfileCard");
  const profileIconBtn = document.getElementById("profileIconBtn");
  const toggleAuthModeBtn = document.getElementById("toggleAuthModeBtn");
  let isSignUpMode = false;

  const openAuth = () => {
    closeDrawer();
    authModal.style.display = "flex";
  };

  if (openAuthBtn) openAuthBtn.addEventListener("click", openAuth);
  if (drawerProfileCard) drawerProfileCard.addEventListener("click", openAuth);
  if (profileIconBtn) profileIconBtn.addEventListener("click", openAuth);
  if (closeAuthBtn) {
    closeAuthBtn.addEventListener("click", () => (authModal.style.display = "none"));
  }

  if (toggleAuthModeBtn) {
    toggleAuthModeBtn.addEventListener("click", () => {
      isSignUpMode = !isSignUpMode;
      document.getElementById("nameGroup").style.display = isSignUpMode ? "block" : "none";
      document.getElementById("phoneGroup").style.display = isSignUpMode ? "block" : "none";
