// 7. REAL-TIME ORDERS & LEADERBOARD LISTENERS
// ==========================================
function listenToUserOrders(uid) {
  if (unsubscribeOrders) unsubscribeOrders();

  const ordersList = document.getElementById("ordersList");
  const countBadge = document.getElementById("orderCountBadge");

  if (!uid) {
    countBadge.textContent = "0 Orders";
    ordersList.innerHTML = `<p class="empty-text">Log in to view your saved cloud orders here.</p>`;
    return;
  }

  const q = query(
    collection(db, "orders"),
    where("userId", "==", uid),
    orderBy("createdAt", "desc"),
    limit(20)
  );

  unsubscribeOrders = onSnapshot(q, (snapshot) => {
    countBadge.textContent = `${snapshot.size} Order${snapshot.size === 1 ? "" : "s"}`;

    if (snapshot.empty) {
      ordersList.innerHTML = `<p class="empty-text">No orders yet. Select a network above to place your first order.</p>`;
      return;
    }

    ordersList.innerHTML = "";
    snapshot.forEach((docSnap) => {
      const o = docSnap.data();
      const dateStr = o.createdAt?.toDate
        ? o.createdAt.toDate().toLocaleString("en-GH", { dateStyle: "medium", timeStyle: "short" })
        : "Just now";

      ordersList.innerHTML += `
        <div class="order-item">
          <div class="order-info">
            <strong>${o.network} ${o.size} &rarr; ${o.phone}</strong>
            <span>${o.orderId} &bull; ${dateStr} &bull; GHS ${o.price.toFixed(2)}</span>
          </div>
          <span class="status-badge">${o.status}</span>
        </div>
      `;
    });
  });
}

function listenToLeaderboard() {
  const leaderboardBody = document.getElementById("leaderboardBody");
  const q = query(collection(db, "users"), orderBy("points", "desc"), limit(10));

  onSnapshot(q, (snapshot) => {
    if (snapshot.empty) {
      leaderboardBody.innerHTML = `<tr><td colspan="3" style="text-align:center; padding: 16px;">No customers ranked yet.</td></tr>`;
      return;
    }

    let rank = 1;
    leaderboardBody.innerHTML = "";
    snapshot.forEach((docSnap) => {
      const u = docSnap.data();
      leaderboardBody.innerHTML += `
        <tr>
          <td>#${rank++}</td>
          <td>${u.name || "Customer"}</td>
          <td>${u.points || 0} pts</td>
        </tr>
      `;
    });
  });
}

