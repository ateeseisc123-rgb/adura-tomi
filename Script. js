// 6. ORDER MODAL & ORDER HISTORY
// ==========================================
const orderModal = document.getElementById("orderModal");
const bundleSelect = document.getElementById("bundleSelect");
const modalTitle = document.getElementById("modalTitle");

function openOrderModal(network, selectedId) {
  modalTitle.textContent = `Buy ${network} Data Bundle`;
  const allPackages = [...BUNDLES[network].standard, ...BUNDLES[network].promo];

  bundleSelect.innerHTML = allPackages
    .map(
      (pkg) =>
        `<option value="${pkg.size}|${pkg.price}" ${pkg.id === selectedId ? "selected" : ""}>
          ${network} ${pkg.size} - GHS ${pkg.price.toFixed(2)} (${pkg.validity})
        </option>`
    )
    .join("");

  orderModal.style.display = "flex";
}

document.getElementById("closeModalBtn").addEventListener("click", () => {
  orderModal.style.display = "none";
});

document.getElementById("bundleForm").addEventListener("submit", (e) => {
  e.preventDefault();
  const [size, price] = bundleSelect.value.split("|");
  const phone = document.getElementById("recipientPhone").value.trim();

  if (!/^0\d{9}$/.test(phone)) {
    alert("Please enter a valid 10-digit Ghanaian phone number (e.g., 0241234567).");
    return;
  }

  const newOrder = {
    id: "ISC-" + Math.floor(100000 + Math.random() * 900000),
    network: currentNetwork,
    size,
    price: parseFloat(price),
    phone,
    date: new Date().toLocaleString("en-GH", { dateStyle: "medium", timeStyle: "short" }),
    status: "Processing"
  };

  orders.unshift(newOrder);
  localStorage.setItem("isc_orders", JSON.stringify(orders));
  renderOrders();
  updateAuthUI();
  orderModal.style.display = "none";
  document.getElementById("bundleForm").reset();

  const msg = encodeURIComponent(
    `Hello ISC ENTERPRISE, I just placed an order:\n` +
    `Order ID: ${newOrder.id}\n` +
    `Network: ${newOrder.network}\n` +
    `Bundle: ${newOrder.size} (GHS ${newOrder.price.toFixed(2)})\n` +
    `Recipient: ${newOrder.phone}`
  );
  window.open(`https://wa.me{msg}`, "_blank");
});

function renderOrders() {
  const ordersList = document.getElementById("ordersList");
  const countBadge = document.getElementById("orderCountBadge");
  countBadge.textContent = `${orders.length} Order${orders.length === 1 ? "" : "s"}`;

  if (orders.length === 0) {
    ordersList.innerHTML = `<p class="empty-text">Log in or place an order to view your data bundles here.</p>`;
    return;
  }

  ordersList.innerHTML = orders
    .map(
      (o) => `
      <div class="order-item">
        <div class="order-info">
          <strong>${o.network} ${o.size} &rarr; ${o.phone}</strong>
          <span>${o.id} &bull; ${o.date} &bull; GHS ${o.price.toFixed(2)}</span>
        </div>
        <span class="status-badge">${o.status}</span>
      </div>
    `
    )
    .join("");
}

document.getElementById("clearOrdersBtn").addEventListener("click", () => {
  if (confirm("Clear your recent order history?")) {
    orders = [];
    localStorage.removeItem("isc_orders");
    renderOrders();
    updateAuthUI();
  }
});

